rules_version = '2';

// Security rules for the Code Code website (Firebase project "sebs-chat").
// Paste this whole file into: Firebase console > Firestore Database > Rules > Publish.
//
// Logins are usernames turned into pretend email addresses: "josh" -> josh@users.sebs-chat.firebaseapp.com
// Seb and Freddie are the bosses (admins). Only Seb can stop the alarm.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email is string; }
    function uname() { return request.auth.token.email.split('@')[0]; }
    function isSeb() { return signedIn() && request.auth.token.email == 'seb@users.sebs-chat.firebaseapp.com'; }
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'seb@users.sebs-chat.firebaseapp.com',
        'freddie@users.sebs-chat.firebaseapp.com'
      ];
    }
    function blocked() {
      return exists(/databases/$(database)/documents/attempts/$(uname()))
        && get(/databases/$(database)/documents/attempts/$(uname())).data.get('blocked', false) == true;
    }
    // A member is someone Seb or Freddie made a login for, whose login is not turned off or blocked.
    function isMember() {
      return isAdmin() || (
        signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
        && !blocked()
      );
    }

    // Logins list (username, display name, turned off or not). Only bosses change it.
    match /users/{uid} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Team cards with levels and jobs.
    match /members/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Everyone chat.
    match /chat_all/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'name', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == uname()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow delete: if isAdmin();
    }

    // Freddie & Seb private chat.
    match /chat_boss/{id} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'name', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
    }

    // Intruder Log: one record per username that got the password wrong.
    // Anyone (even logged out) can record a wrong try or add a face scan,
    // but only Seb or Freddie can read the log or unblock someone.
    match /attempts/{u} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['username', 'at', 'count', 'blocked', 'photo', 'photoAt'])
        && request.resource.data.username == u
        && u.size() <= 30
        && request.resource.data.get('photo', '') is string
        && request.resource.data.get('photo', '').size() < 300000
        && !(resource != null
             && resource.data.get('blocked', false) == true
             && request.resource.data.get('blocked', false) != true)
      );
    }

    // The alarm. Anyone can set it off; only Seb can stop it.
    match /alarm/{id} {
      allow read: if isMember();
      allow write: if id == 'current'
        && request.resource.data.keys().hasOnly(['at', 'kind', 'username', 'stopped', 'stoppedAt'])
        && request.resource.data.kind in ['real', 'practice', 'test']
        && (request.resource.data.stopped == false || isSeb());
    }
  }
}
